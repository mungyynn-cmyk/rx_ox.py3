local function GetToday() return os.date("%d/%m/%Y") end
local function GetDailyTimes()
    if not (isfile and readfile and writefile) then return 1 end
    local today = GetToday()
    local times = 0
    if isfile("rx_ox_daily.txt") then
        local sDate, sTimes = string.match(readfile("rx_ox_daily.txt"), "(.+)|(.+)")
        if sDate == today and tonumber(sTimes) then times = tonumber(sTimes) else times = (tonumber(sTimes) or 0) + 1 end
    else times = 1 end
    writefile("rx_ox_daily.txt", today .. "|" .. tostring(times))
    return times
end
