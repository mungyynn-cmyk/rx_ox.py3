local function LoadLibrary()
    local url = "https://raw.githubusercontent.com/lxte/lates-lib/main/Main.lua"
    if not shared.rx_ox_lib then
        local success, result = pcall(function() return game:HttpGet(url) end)
        if success then shared.rx_ox_lib = result else return nil end
    end
    local success, lib = pcall(function() return loadstring(shared.rx_ox_lib)() end)
    if success then return lib else return nil end
end

